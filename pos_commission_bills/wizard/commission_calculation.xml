<odoo>
    <data>

        <!-- Wizard Form View -->
        <record id="view_commission_wizard_form" model="ir.ui.view">
            <field name="name">commission.wizard.form</field>
            <field name="model">commission.wizard</field>
            <field name="arch" type="xml">
                <form string="Commission Calculation">
                    <field name="is_full_refund" invisible="1"/>
                    <div class="alert alert-warning pb-1" role="alert" invisible="not is_full_refund">
                        <p>The selected line includes a full refund line and cannot be used to calculate commission!</p>
                    </div>

                    <group>
                        <field name="partner_id"/>
                        <field name="date_start"/>
                    </group>
                    <footer>
                        <button name="action_calculate_commission"
                                type="object"
                                class="btn-primary"
                                string="Calculate Commission"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_commission_wizard" model="ir.actions.act_window">
            <field name="name">Calculate Commission</field>
            <field name="res_model">commission.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="point_of_sale.model_pos_order_line"/>
            <field name="binding_view_types">list</field>
        </record>

    </data>
</odoo>
