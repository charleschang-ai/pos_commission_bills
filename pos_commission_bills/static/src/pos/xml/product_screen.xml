<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="asta_pos_commission_customization.ProductScreen" t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[@class='subpads d-flex flex-column gap-2']//Numpad" position="after">
            <div class="d-flex gap-2 px-2 pt-2 justify-content-between">
                <button
                        t-att-class="'btn btn-light btn-lg w-100 ' + (pos.numpadMode === 'comm' ? 'active btn-primary text-white' : '')"
                        t-on-click="() => this.onNumpadClick('comm')"
                        t-esc="'Commission Rate'"
                />
            </div>
        </xpath>
    </t>
</templates>
