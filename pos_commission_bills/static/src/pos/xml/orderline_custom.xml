<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="asta_pos_commission_customization.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[@class='info-list d-flex flex-column']//li[@class='price-per-unit']" position="inside">
            <t t-if="!props.is_report">
                <span class="qty px-1 border rounded text-bg-view fw-bolder me-1 ms-2"><t t-esc="line.commission_rate"/>%</span>
            </t>
        </xpath>
    </t>

    <t t-name="asta_pos_commission_customization.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[@class='pos-receipt p-2']//Orderline" position="attributes">
            <attribute name="is_report">true</attribute>
        </xpath>
    </t>

</templates>