<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view_add" model="ir.ui.view">
        <field name="name">product.template.product.form.add</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="commission_rate"/>
                <field name="storage_fees"/>
            </xpath>
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="commission_ok"/>
                    <label for="commission_ok"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='pos_categ_ids']" position="after">
                <field name="customer_id"/>
            </xpath>

        </field>
    </record>
</odoo>