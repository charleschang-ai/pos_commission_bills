<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_move_form_add" model="ir.ui.view">
        <field name="name">view.account.move.form.add1</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='quantity']" position="after">
                <field name="original_qty" optional="hide"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
                <field name="original_price_unit" optional="hide"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
                <field name="original_price"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
                <field name="commission_rate"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
                <field name="commission_fees"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
                <field name="storage_fees"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
                <field name="pos_line_id" optional="hide"
                       column_invisible="parent.move_type in ['out_invoice', 'in_refund', 'in_receipt']"/>
            </xpath>
        </field>
    </record>
</odoo>