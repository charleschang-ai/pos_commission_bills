<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_pos_form_add" model="ir.ui.view">
        <field name="name">view.pos.form.add1</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']//list//field[@name='discount']" position="after">
                <field name="commission_rate"/>
                <field name="storage_fees"/>
            </xpath>
        </field>
    </record>
</odoo>